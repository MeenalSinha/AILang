// Integration test: if/else, while, for, break, continue.
fn classify(n: int) -> string {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}
assert(classify(-5) == "negative");
assert(classify(0) == "zero");
assert(classify(5) == "positive");

let total = 0;
for i in 0..=5 {
    total += i;
}
assert(total == 15); // 0+1+2+3+4+5

let count = 0;
let i = 0;
while i < 20 {
    i += 1;
    if i % 2 == 0 {
        continue;
    }
    if i > 10 {
        break;
    }
    count += 1;
}
assert(count == 5); // 1,3,5,7,9
