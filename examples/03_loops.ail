// while and for loops, plus break/continue.
let i = 0;
while i < 5 {
    println("while: " + to_string(i));
    i += 1;
}

for n in 0..5 {
    println("for: " + to_string(n));
}

for n in 0..10 {
    if n % 2 == 0 {
        continue;
    }
    if n > 7 {
        break;
    }
    println("odd, <=7: " + to_string(n));
}
